{
  "name": "remote-sandbox",
  "displayName": "Remote Sandbox",
  "description": "Manage E2B, Freestyle, and Tensorlake sandboxes and connect to them from VS Code.",
  "version": "3.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/starfall-org/remote-sandbox-vscode.git"
  },
  "license": "GPL-3.0-only",
  "publisher": "starfall",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:tensorlake",
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remote-sandbox",
          "title": "Remote Sandbox",
          "icon": "$(cloud)"
        }
      ],
      "panel": [
        {
          "id": "remote-sandbox-ports-panel",
          "title": "Ports",
          "icon": "media/ports.svg"
        }
      ]
    },
    "views": {
      "remote-sandbox": [
        {
          "id": "remote-sandbox-sandboxes-sidebar",
          "name": "Sandboxes",
          "type": "tree",
          "when": "true",
          "icon": "$(server)"
        }
      ],
      "remote-sandbox-ports-panel": [
        {
          "id": "remote-sandbox-ports",
          "name": "Ports",
          "type": "tree",
          "when": "remoteSandbox.tensorlakeConnected"
        }
      ]
    },
    "commands": [
      {
        "command": "remote-sandbox.refreshSandboxes",
        "title": "Refresh Sandboxes",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-sandbox.e2bPauseSandbox",
        "title": "E2B: Pause Sandbox",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-sandbox.e2bResumeSandbox",
        "title": "E2B: Resume Sandbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.e2bListSandboxes",
        "title": "E2B: List Sandboxes"
      },
      {
        "command": "remote-sandbox.e2bSetApiKey",
        "title": "E2B: Set API Key"
      },
      {
        "command": "remote-sandbox.e2bCreateSandbox",
        "title": "E2B: Create Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.e2bDeleteSandbox",
        "title": "E2B: Delete Sandbox",
        "icon": "$(trash)"
      },
      {
        "command": "remote-sandbox.freestyleSetApiKey",
        "title": "Freestyle: Set API Key"
      },
      {
        "command": "remote-sandbox.freestyleCreateVm",
        "title": "Freestyle: Create VM",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.freestyleSuspendVm",
        "title": "Freestyle: Suspend VM",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-sandbox.freestyleStartVm",
        "title": "Freestyle: Start VM",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.freestyleResumeVm",
        "title": "Freestyle: Resume VM",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.freestyleDeleteVm",
        "title": "Freestyle: Delete VM",
        "icon": "$(trash)"
      },
      {
        "command": "remote-sandbox.freestyleListVms",
        "title": "Freestyle: List VMs"
      },
      {
        "command": "remote-sandbox.connectInCurrentWindow",
        "title": "Connect in Current Window",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-sandbox.connectInNewWindow",
        "title": "Connect in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-sandbox.tensorlakeSetApiKey",
        "title": "Tensorlake: Set API Key"
      },
      {
        "command": "remote-sandbox.tensorlakeCreateSandbox",
        "title": "Tensorlake: Create Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.tensorlakeSuspendSandbox",
        "title": "Tensorlake: Suspend Sandbox",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-sandbox.tensorlakeResumeSandbox",
        "title": "Tensorlake: Resume Sandbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.tensorlakeDeleteSandbox",
        "title": "Tensorlake: Terminate Sandbox",
        "icon": "$(trash)"
      },
      {
        "command": "remote-sandbox.tensorlakeListSandboxes",
        "title": "Tensorlake: Connect"
      },
      {
        "command": "remote-sandbox.tensorlakeConnectInCurrentWindow",
        "title": "Tensorlake: Connect in Current Window",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-sandbox.tensorlakeConnectInNewWindow",
        "title": "Tensorlake: Connect in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-sandbox.openTerminal",
        "title": "Tensorlake: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "remote-sandbox.openTerminalAtPath",
        "title": "Open in Tensorlake Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "remote-sandbox.exposePublicPort",
        "title": "Tensorlake: Expose Public Port",
        "icon": "$(globe)"
      },
      {
        "command": "remote-sandbox.openConnectedFolder",
        "title": "Tensorlake: Open Folder...",
        "icon": "$(folder-opened)"
      },
      {
        "command": "remote-sandbox.cloneGitRepository",
        "title": "Tensorlake: Clone Git Repository...",
        "icon": "$(repo-clone)"
      },
      {
        "command": "remote-sandbox.refreshPorts",
        "title": "Refresh Ports",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-sandbox.openPort",
        "title": "Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "remote-sandbox.copyPortUrl",
        "title": "Copy Port URL",
        "icon": "$(copy)"
      },
      {
        "command": "remote-sandbox.removePort",
        "title": "Remove Public Port",
        "icon": "$(close)"
      },
      {
        "command": "remote-sandbox.connectRecentFolderInCurrentWindow",
        "title": "Connect in Current Window",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-sandbox.connectRecentFolderInNewWindow",
        "title": "Connect in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-sandbox.removeRecentFolder",
        "title": "Remove from Recent",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remote-sandbox.refreshSandboxes",
          "when": "view == remote-sandbox-sandboxes-sidebar",
          "group": "navigation@3"
        },
        {
          "command": "remote-sandbox.exposePublicPort",
          "when": "view == remote-sandbox-ports",
          "group": "navigation@1"
        },
        {
          "command": "remote-sandbox.refreshPorts",
          "when": "view == remote-sandbox-ports",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-sandbox.e2bCreateSandbox",
          "when": "viewItem == e2bSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.freestyleCreateVm",
          "when": "viewItem == freestyleSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.tensorlakeCreateSandbox",
          "when": "viewItem == tensorlakeSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.e2bPauseSandbox",
          "when": "viewItem == e2bSandboxRunning && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.e2bResumeSandbox",
          "when": "viewItem == e2bSandboxPaused && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.connectInCurrentWindow",
          "when": "viewItem =~ /e2bSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.connectInNewWindow",
          "when": "viewItem =~ /e2bSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.e2bDeleteSandbox",
          "when": "viewItem =~ /e2bSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.freestyleSuspendVm",
          "when": "viewItem == freestyleVmRunning && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.freestyleStartVm",
          "when": "viewItem == freestyleVmStopped && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.freestyleResumeVm",
          "when": "viewItem == freestyleVmSuspended && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.connectInCurrentWindow",
          "when": "viewItem =~ /freestyleVm/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.connectInNewWindow",
          "when": "viewItem =~ /freestyleVm/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.freestyleDeleteVm",
          "when": "viewItem =~ /freestyleVm/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.tensorlakeSuspendSandbox",
          "when": "viewItem == tensorlakeSandboxRunning && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.tensorlakeResumeSandbox",
          "when": "viewItem == tensorlakeSandboxSuspended && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.tensorlakeConnectInCurrentWindow",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.tensorlakeConnectInNewWindow",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.tensorlakeDeleteSandbox",
          "when": "viewItem =~ /tensorlakeSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.exposePublicPort",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "2_network@1"
        },
        {
          "command": "remote-sandbox.openTerminal",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "1_actions@3"
        },
        {
          "command": "remote-sandbox.connectRecentFolderInCurrentWindow",
          "when": "viewItem == tensorlakeRecentFolder && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.removeRecentFolder",
          "when": "viewItem == tensorlakeRecentFolder && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@9"
        },
        {
          "command": "remote-sandbox.connectRecentFolderInNewWindow",
          "when": "viewItem == tensorlakeRecentFolder && view == remote-sandbox-sandboxes-sidebar",
          "group": "1_actions@2"
        },
        {
          "command": "remote-sandbox.openPort",
          "when": "view == remote-sandbox-ports && viewItem == tensorlakePort",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.copyPortUrl",
          "when": "view == remote-sandbox-ports && viewItem == tensorlakePort",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.removePort",
          "when": "view == remote-sandbox-ports && viewItem == tensorlakePort",
          "group": "inline@9"
        }
      ],
      "explorer/context": [
        {
          "command": "remote-sandbox.openTerminalAtPath",
          "when": "resourceScheme == tensorlake && explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Remote Sandbox",
      "properties": {
        "remoteSandbox.e2bApiKey": {
          "type": "string",
          "default": "",
          "editPresentation": "password",
          "markdownDescription": "Your [E2B](https://e2b.dev) API key. The extension uses this to authenticate with the E2B API. Set it here, run the **E2B: Set API Key** command, or use the `E2B_API_KEY` environment variable."
        },
        "remoteSandbox.freestyleApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your [Freestyle](https://freestyle.sh) API key. The extension uses this to authenticate with the Freestyle API. Set it here, run the **Freestyle: Set API Key** command, or use the `FREESTYLE_API_KEY` environment variable.",
          "editPresentation": "password"
        },
        "remoteSandbox.tensorlakeApiKey": {
          "type": "string",
          "default": "",
          "editPresentation": "password",
          "markdownDescription": "Your [Tensorlake](https://tensorlake.ai) API key. The extension uses it for sandbox lifecycle and lightweight remote operations. Set it here, run the **Tensorlake: Set API Key** command, or use the `TENSORLAKE_API_KEY` environment variable.",
          "scope": "application"
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "remote-sandbox.tensorlakeTerminal",
          "title": "Tensorlake",
          "icon": "cloud"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remote-sandbox-ports",
        "contents": "No exposed Tensorlake ports.\n\n[Forward a Port](command:remote-sandbox.exposePublicPort)",
        "when": "remoteSandbox.tensorlakeConnected"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
